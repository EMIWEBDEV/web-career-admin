APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Khusus local/testing: akun kandidat baru langsung terverifikasi.
# Di production fitur tetap dipaksa nonaktif oleh guard pada backend.
CAREER_AUTO_VERIFY_EMAIL=false
CAREER_DIVISI_INFO_ENABLED=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# webcareers = tabel N_WEB_CAREERS_Jobs, dijalankan `php artisan queue:work`.
# cloudtasks = Google Cloud Tasks (produksi). Nama antreannya melekat di job
# masing-masing (mis. WcPenjadwalanJob::QUEUE), bukan dari env.
QUEUE_CONNECTION=webcareers
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRASI HCLEARN / CAT — kanal Web Careers
# ─────────────────────────────────────────────────────────────────────────────
# MODE — pilih SATU, sisanya biarkan dikomentari.
# Bila ada lebih dari satu yang aktif, yang dipakai adalah BARIS PALING BAWAH;
# jadi jangan mengandalkan itu — komentari yang tidak dipakai.
# Salah tulis (mis. "prod") ditolak dengan pesan yang menyebut mode yang sah.
HCLEARN_ENV=development
# HCLEARN_ENV=staging
# HCLEARN_ENV=production

HCLEARN_URL_DEVELOPMENT=http://cat-evo-pembaharuan.test
HCLEARN_URL_STAGING=https://cat-evo-stagging-595840247695.asia-southeast1.run.app
HCLEARN_URL_PRODUCTION=https://hclearn.evonusabersaudara.co.id

# Kredensial KANAL WEB CAREERS. Berbeda dari HCLEARN_API_* milik HCIS —
# jangan dipakai bergantian. Isi dengan nilai dari tim CAT per lingkungan.
HCLEARN_WC_API_PUBLIC=
HCLEARN_WC_API_SECRET=

HCLEARN_TIMEOUT=30
HCLEARN_RETRY=2

# Kamera WAJIB aktif saat ujian — dipaksa dari sisi Web Careers agar CAT tidak
# pernah menjalankan sesi tanpa kamera.
HCLEARN_WAJIB_KAMERA=true

# ── Callback hasil tes (CAT → Web Careers) ──
# WC_PUBLIC_URL harus URL Web Careers yang BISA DIJANGKAU CAT, dan berbeda per
# lingkungan. Setelah mengubahnya WAJIB `php artisan config:clear` — config yang
# ter-cache membuat CAT mengirim hasil ke host lama tanpa error apa pun.
WC_PUBLIC_URL=https://web-careers.test
WC_CALLBACK_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── LOG VIEWER ────────────────────────────────────────────────────────────
# Kunci pembuka /log-viewer, 64 karakter. Tanpa ?secret-key= yang cocok,
# halamannya membalas 404 — dan KOSONG berarti tertutup untuk semua.
# Buat kuncinya: php -r "echo bin2hex(random_bytes(32));"
LOG_VIEWER_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
#  TAMBAHAN — DUKUNGAN SERVER SURAT (EVO MAIL)
# ═══════════════════════════════════════════════════════════════════════════
#
#  Blok ini TAMBAHAN, dan ia MENGGANTIKAN seluruh baris MAIL_* yang dulu ada
#  di berkas ini. Kalau menyalin .env lama, JANGAN bawa MAIL_HOST,
#  MAIL_USERNAME, dan MAIL_PASSWORD-nya: layanan ini sudah tidak membacanya,
#  dan kredensial yang menganggur di berkas env hanya menunggu bocor.
#
#  SELURUH email Web Careers berangkat lewat EVO Mail Server — verifikasi
#  akun, hasil lamaran, undangan jadwal, dan dua surat reset kata sandi.
#  Tidak ada lagi jalur cadangan: tidak ada berkas surat, tidak ada mailer,
#  tidak ada panggilan Mail:: di mana pun. Yang dipegang layanan ini cuma
#  kunci API di bawah, dan kunci itu tidak bisa dipakai berkirim surat dari
#  alamat mana pun selain yang sudah ditetapkan untuknya.
#
#  Yang TIDAK berubah: antrean dan percobaan ulangnya. WcSyncEmailJob,
#  WcApplyEmailJob, dan WcJadwalEmailJob tetap yang memutuskan kapan sebuah
#  surat dikirim dan untuk kandidat mana — merekalah yang tahu konteksnya.
#  Server surat cuma dipanggil dari DALAM job itu.
#
# ───────────────────────────────────────────────────────────────────────────

# Alamat server surat. Ini SATU-SATUNYA baris yang berbeda antar lingkungan —
# ganti saat pindah ke produksi, sisanya tetap.
SURAT_BASIS=https://evo-mail-595840247695.asia-southeast1.run.app

# ── KUNCI API ──────────────────────────────────────────────────────────────
#
# Diterbitkan DI SISI SERVER SURAT, sekali:
#
#     php artisan surat:aplikasi buat --kode=WEB_CAREERS ...
#
# Yang diserahkan tepat DUA. Keduanya BERBEDA dari kunci HCLearn/CAT yang
# sudah ada di berkas ini — jangan sampai tertukar: tanda tangannya akan
# selalu gagal, dan gejalanya cuma 401 tanpa penjelasan apa pun.
#
#   SURAT_API_PUBLIC  pengenal. Ikut terkirim tiap permintaan lewat header
#                     X-HC-Public, boleh terbaca di log, bukan rahasia.
#   SURAT_API_SECRET  kunci penanda tangan. TIDAK PERNAH melintas jaringan —
#                     ia dipakai menghitung HMAC, bukan dikirim.
#
# Tiap lingkungan WAJIB punya kuncinya sendiri. Kunci yang sama lintas
# lingkungan berarti staging bisa mengirim surat atas nama produksi.
SURAT_API_PUBLIC=
SURAT_API_SECRET=

# ── BATAS WAKTU ────────────────────────────────────────────────────────────
#
# Server surat mengirim SERENTAK di dalam permintaan — ia tidak mengantre —
# jadi angkanya harus memberi ruang untuk satu jabat tangan SMTP penuh
# (terukur 3-5 detik).
#
# Jangan berlebihan: panggilan yang kehabisan waktu akan diulang job, padahal
# suratnya boleh jadi sudah telanjur berangkat. Surat gandanya lahir dari
# kegagalan yang sebenarnya tidak pernah ada.
SURAT_TIMEOUT=25

# ── KUNCI IDEMPOTENSI ──────────────────────────────────────────────────────
#
# Tidak ada env untuk ini — kuncinya disusun DI DALAM KODE dari pengenal yang
# memang tetap, mis. 'verif:'.$idUser.':'.$idToken.
#
# Disebut di sini karena ia yang menutup lubang paling mahal: jaringan putus
# SESUDAH server surat mengirim tapi SEBELUM jawabannya sampai. Job
# menyimpulkan gagal, Cloud Tasks mengulang, dan kandidat menerima surat
# penolakan lamaran dua kali. Lihat docs/INTEGRASI.md di repo evo-mail.

# ═══════════════════════════════════════════════════════════════════════════
# META HALAMAN & KARTU PRATINJAU TAUTAN  (config/seo.php)
# ═══════════════════════════════════════════════════════════════════════════
#
# Yang menentukan tampilan tautan saat dibagikan ke WhatsApp/LinkedIn: logo,
# judul, dan deskripsinya. SELURUH URL (og:url, og:image, canonical) dibangun
# dari host permintaan, jadi TIDAK ADA env berisi domain di sini — lokal,
# staging, dan produksi memakai berkas yang sama tanpa diubah.

# Akhiran judul tab: "{Nama Halaman} | Careers Evo Group".
SEO_SITE_NAME="Careers Evo Group"

# Boleh diindeks mesin pencari? Kosongkan untuk memakai bawaan
# (true HANYA saat APP_ENV=production). Staging WAJIB false supaya tidak
# bersaing dengan produksi di hasil Google — pratinjau WhatsApp tetap jalan.
# SEO_INDEXABLE=false

# Kartu pratinjau 1200x630, relatif terhadap public/.
# Buat ulang setelah logo berubah: php artisan seo:og-image
# SEO_IMAGE=og/og-default.jpg

# Judul & deskripsi halaman depan (bawaannya sudah terisi di config/seo.php).
# SEO_DEFAULT_TITLE="Karier Bersama EVO Group"
# SEO_DEFAULT_DESCRIPTION="..."

# Akun sosial resmi — dipakai JSON-LD "sameAs" dan kartu X/Twitter.
# SEO_TWITTER_SITE=@evogroup
# SEO_SOCIAL_INSTAGRAM=https://www.instagram.com/...
# SEO_SOCIAL_LINKEDIN=https://www.linkedin.com/company/...

# ── SEO / MESIN PENCARI ──────────────────────────────────────────────────────
# Kode verifikasi dari Google Search Console (Setelan → Verifikasi kepemilikan
# → Tag HTML). Salin NILAI content="..."-nya saja, bukan seluruh tagnya.
# Dibiarkan kosong = tagnya tidak dicetak sama sekali.
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

# Indeks mesin pencari. Otomatis mengikuti APP_ENV=production bila tidak diisi;
# isi 'false' untuk menutup staging yang kebetulan APP_ENV-nya production.
# SEO_INDEXABLE=true

# Wilayah — menegaskan lowongan di situs ini berada di Sumatera Selatan.
SEO_GEO_PLACE="Palembang"
SEO_GEO_REGION="Sumatera Selatan"
SEO_GEO_POSITION="-2.976074, 104.775429"

# Nama lain & anak usaha. Dipisah koma. Google memakainya menyatukan entitas —
# tanpa ini "EVO", "PT EVO Group", dan tiap anak usaha dianggap berbeda.
# SEO_ALTERNATE_NAMES="PT EVO Group, EVO, EVO Group Palembang"
# SEO_SUB_ORGANIZATIONS="PT Evo Manufacturing Indonesia, PT Evo Nusa Bersaudara"
# SEO_AREA_SERVED="Palembang, Sumatera Selatan, Sumatera, Indonesia"
